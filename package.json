{
  "name": "hidaya-online-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Hidaya Online — API + realtime (Express, MongoDB/Mongoose, Socket.IO)",
  "main": "app.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
